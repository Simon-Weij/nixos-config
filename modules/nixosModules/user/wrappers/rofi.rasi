* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: #cdd6f4;
    foreground: #cdd6f4;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

window {
    transparency: "real";
    background-color: #1e1e2eee;
    border: 1px solid;
    border-color: #0262ac;
    border-radius: 12px;
    width: 600px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 10px;
    padding: 8px 12px;
    background-color: #313244;
    border-radius: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #89b4fa;
}

entry {
    placeholder: "Search apps...";
    placeholder-color: #6c7086;
    text-color: #cdd6f4;
}

listview {
    lines: 3;
    columns: 1;
    spacing: 8px;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 8px;
    spacing: 12px;
    orientation: horizontal;
    background-color: #313244;
    text-color: #cdd6f4;
}

element normal.normal,
element normal.active,
element alternate.normal,
element alternate.active {
    background-color: #313244;
    text-color: #cdd6f4;
}

element selected.normal,
element selected.active {
    background-color: #0262ac;
    text-color: #ffffff;
    border: 1px solid;
    border-color: #89b4fa;
}

element-icon {
    size: 32px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}