[
  {
    "context": "Workspace",
    "bindings": {}
  },
  {
    "bindings": {
      "backspace": "editor::Backspace"
    }
  },
  {
    "bindings": {
      "xf86tools": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "h": "vim::Left",
      "l": "vim::Right",
      "k": "vim::Up",
      "j": "vim::Down",
      "p": "vim::Paste",
      "y": "vim::VisualYank",
      "f": "vim::NextWordEnd",
      "a": "vim::InsertAfter",
      "i": "vim::InsertBefore",
      "d": "vim::PreviousWordStart",
      "u": "vim::Undo",
      "r": "vim::Redo",
      "$": "vim::EndOfLine",
      "z": "vim::StartOfLine",
      "v": "vim::ToggleVisual",
      "ctrl-f": "buffer_search::Deploy",
      "s": "vim::Matching",
      "x": "vim::DeleteLeft",
      "w": "editor::ToggleFold",
      "x x": "vim::VisualDeleteLine",
      "ctrl-h": "project_panel::ToggleFocus",
      "ctrl-l": "pane::GoForward",
      "ctrl-b": "terminal_panel::ToggleFocus",
      "ctrl-c": "editor::Copy"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "escape": "vim::NormalBefore",
      "ctrl-h": "vim::Left",
      "ctrl-l": "vim::Right",
      "ctrl-j": "vim::Down",
      "ctrl-k": "vim::Up",
      "ctrl-f": "vim::NextWordEnd",
      "ctrl-d": "vim::PreviousWordEnd",
      "ctrl-b": "terminal_panel::ToggleFocus",
      "ctrl-c": "editor::Copy",
      "enter": "editor::Newline"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-b": "terminal_panel::ToggleFocus",
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-shift-v": "terminal::Paste",
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-l": "terminal::Clear",
      "ctrl-shift-t": "workspace::NewTerminal",
      "ctrl-shift-k": "terminal::ScrollLineUp",
      "ctrl-shift-j": "terminal::ScrollLineDown"
    }
  },
  {
    "context": "ProjectPanel && !editing",
    "bindings": {
      "k": "menu::SelectPrevious",
      "j": "menu::SelectNext",
      "enter": "project_panel::Open",
      "a": "project_panel::NewFile",
      "p": "project_panel::NewDirectory",
      "d": "project_panel::Delete"
    }
  },
  {
    "context": "ProjectPanel && editing",
    "bindings": {
      "escape": "menu::Cancel",
      "enter": "menu::Confirm"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "escape": "buffer_search::Dismiss",
      "enter": "search::SelectNextMatch",
      "shift-enter": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "FileFinder",
    "bindings": {
      "escape": "menu::Cancel",
      "enter": "menu::Confirm"
    }
  },
  {
    "context": "Prompt",
    "bindings": {
      "enter": "menu::Confirm"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "0": ["vim::Number", 0],
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9]
    }
  },
  {
    "bindings": {
      "ctrl-tab": "tab_switcher::Toggle",
      "ctrl-q": "pane::CloseActiveItem",
      "ctrl-s": "workspace::Save",
      "ctrl-v": "file_finder::Toggle",
      "ctrl-space": "editor::ShowCompletions",
      "tab": "editor::ConfirmCompletion"
    }
  }
]
