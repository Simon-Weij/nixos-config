{
  "base_keymap": "None",
  "disable_ai": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "use_multiline_find": true,
  "lsp": {
    "qml": {
      "binary": {
        "arguments": ["-E"]
      }
    }
  },

  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Dark"
  },
  "title_bar": {
    "show_sign_in": false
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.direnv",
    "**/target",
    "**/node_modules"
  ],
  "relative_line_numbers": "enabled",

  "tabs": {
    "max_tabs": 5
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true
    }
  }
}
