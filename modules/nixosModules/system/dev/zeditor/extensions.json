{
  "extensions": {
    "dockerfile": {
      "manifest": {
        "id": "dockerfile",
        "name": "Dockerfile",
        "version": "0.2.0",
        "schema_version": 1,
        "description": "Dockerfile support.",
        "repository": "https://github.com/zed-extensions/dockerfile",
        "authors": [
          "d1y <chenhonzho@gmail.com>",
          "joshmeads <github@joshmeads.com>"
        ],
        "lib": {
          "kind": "Rust",
          "version": "0.7.0"
        },
        "themes": [],
        "icon_themes": [],
        "languages": ["languages/dockerfile"],
        "grammars": {
          "dockerfile": {
            "repository": "https://github.com/camdencheek/tree-sitter-dockerfile",
            "rev": "868e44ce378deb68aac902a9db68ff82d2299dd0",
            "path": null
          }
        },
        "language_servers": {
          "docker-language-server": {
            "language": "Dockerfile",
            "languages": ["Dockerfile", "Docker Compose"],
            "language_ids": {
              "Dockerfile": "dockerfile",
              "Docker Compose": "docker-compose"
            },
            "code_action_kinds": null
          },
          "dockerfile-language-server": {
            "language": "Dockerfile",
            "languages": [],
            "language_ids": {},
            "code_action_kinds": null
          }
        },
        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": [],
        "debug_adapters": {
          "buildx-dockerfile": {
            "schema_path": "./debug_adapter_schemas/buildx-dockerfile.json"
          }
        }
      },
      "dev": false
    },
    "git-firefly": {
      "manifest": {
        "id": "git-firefly",
        "name": "Git Firefly",
        "version": "0.1.4",
        "schema_version": 1,
        "description": "Provides Git Syntax Highlighting",
        "repository": "https://github.com/d1y/git_firefly",
        "authors": [
          "d1y <chenhonzhou@gmail.com>",
          "Peter Tripp <petertripp@gmail.com>"
        ],
        "lib": {
          "kind": null,
          "version": null
        },
        "themes": [],
        "icon_themes": [],
        "languages": [
          "languages/gitignore",
          "languages/gitattributes",
          "languages/gitrebase",
          "languages/gitconfig"
        ],
        "grammars": {
          "git_config": {
            "repository": "https://github.com/the-mikedavis/tree-sitter-git-config",
            "rev": "9c2a1b7894e6d9eedfe99805b829b4ecd871375e",
            "path": null
          },
          "git_rebase": {
            "repository": "https://github.com/the-mikedavis/tree-sitter-git-rebase",
            "rev": "d8a4207ebbc47bd78bacdf48f883db58283f9fd8",
            "path": null
          },
          "gitattributes": {
            "repository": "https://github.com/tree-sitter-grammars/tree-sitter-gitattributes",
            "rev": "41940e199ba5763abea1d21b4f717014b45f01ea",
            "path": null
          },
          "gitignore": {
            "repository": "https://github.com/shunsambongi/tree-sitter-gitignore",
            "rev": "f4685bf11ac466dd278449bcfe5fd014e94aa504",
            "path": null
          }
        },
        "language_servers": {},
        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "html": {
      "manifest": {
        "id": "html",
        "name": "HTML",
        "version": "0.3.1",
        "schema_version": 1,
        "description": "HTML support.",
        "repository": "https://github.com/zed-industries/zed",
        "authors": ["Isaac Clayton <slightknack@gmail.com>"],
        "lib": {
          "kind": "Rust",
          "version": "0.7.0"
        },
        "themes": [],
        "icon_themes": [],
        "languages": ["languages/html"],
        "grammars": {
          "html": {
            "repository": "https://github.com/tree-sitter/tree-sitter-html",
            "rev": "bfa075d83c6b97cd48440b3829ab8d24a2319809",
            "path": null
          }
        },
        "language_servers": {
          "vscode-html-language-server": {
            "language": "HTML",
            "languages": [],
            "language_ids": {
              "CSS": "css",
              "HTML": "html"
            },
            "code_action_kinds": null
          }
        },
        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "nix": {
      "manifest": {
        "id": "nix",
        "name": "Nix",
        "version": "0.1.4",
        "schema_version": 1,
        "description": "Nix support.",
        "repository": "https://github.com/zed-extensions/nix",
        "authors": ["Hasit Mistry <hasitnm@gmail.com>"],
        "lib": {
          "kind": "Rust",
          "version": "0.7.0"
        },
        "themes": [],
        "icon_themes": [],
        "languages": ["languages/nix"],
        "grammars": {
          "nix": {
            "repository": "https://github.com/nix-community/tree-sitter-nix",
            "rev": "ea1d87f7996be1329ef6555dcacfa63a69bd55c6",
            "path": null
          }
        },
        "language_servers": {
          "nil": {
            "language": "Nix",
            "languages": [],
            "language_ids": {},
            "code_action_kinds": null
          },
          "nixd": {
            "language": "Nix",
            "languages": [],
            "language_ids": {},
            "code_action_kinds": null
          }
        },
        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "toml": {
      "manifest": {
        "id": "toml",
        "name": "TOML",
        "version": "1.0.2",
        "schema_version": 1,
        "description": "TOML support.",
        "repository": "https://github.com/zed-extensions/toml",
        "authors": [
          "Max Brunsfeld <max@zed.dev>",
          "Ammar Arif <evergreenkary@gmail.com>"
        ],
        "lib": {
          "kind": null,
          "version": null
        },
        "themes": [],
        "icon_themes": [],
        "languages": ["languages/toml"],
        "grammars": {
          "toml": {
            "repository": "https://github.com/tree-sitter/tree-sitter-toml",
            "rev": "342d9be207c2dba869b9967124c679b5e6fd0ebe",
            "path": null
          }
        },
        "language_servers": {},
        "context_servers": {},
        "agent_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    }
  },
  "themes": {},
  "icon_themes": {},
  "languages": {
    "Dockerfile": {
      "extension": "dockerfile",
      "path": "languages/dockerfile",
      "matcher": {
        "path_suffixes": ["Dockerfile", "Containerfile", "dockerfile"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "dockerfile"
    },
    "Git Attributes": {
      "extension": "git-firefly",
      "path": "languages/gitattributes",
      "matcher": {
        "path_suffixes": ["gitattributes", ".gitattributes"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "gitattributes"
    },
    "Git Config": {
      "extension": "git-firefly",
      "path": "languages/gitconfig",
      "matcher": {
        "path_suffixes": [
          "config.worktree",
          ".gitconfig",
          ".gitmodules",
          ".lfsconfig"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "git_config"
    },
    "Git Ignore": {
      "extension": "git-firefly",
      "path": "languages/gitignore",
      "matcher": {
        "path_suffixes": [
          ".containerignore",
          ".cursorignore",
          ".dockerignore",
          ".eslintignore",
          ".fdignore",
          ".gitignore",
          ".git-blame-ignore-revs",
          ".ignore",
          ".npmignore",
          ".prettierignore",
          ".rgignore",
          ".vscodeignore"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "gitignore"
    },
    "Git Rebase": {
      "extension": "git-firefly",
      "path": "languages/gitrebase",
      "matcher": {
        "path_suffixes": ["git-rebase-todo"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "git_rebase"
    },
    "HTML": {
      "extension": "html",
      "path": "languages/html",
      "matcher": {
        "path_suffixes": ["html", "htm", "shtml"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "html"
    },
    "Nix": {
      "extension": "nix",
      "path": "languages/nix",
      "matcher": {
        "path_suffixes": ["nix"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "nix"
    },
    "TOML": {
      "extension": "toml",
      "path": "languages/toml",
      "matcher": {
        "path_suffixes": ["Cargo.lock", "toml", "Pipfile", "uv.lock"],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "toml"
    }
  }
}
