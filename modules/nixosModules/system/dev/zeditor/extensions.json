      "dev": false
    }
  },
  "themes": {},
  "icon_themes": {},
  "languages": {
    "Git Attributes": {
      "extension": "git-firefly",
      "path": "languages/gitattributes",
      "matcher": {
        "path_suffixes": [
          "gitattributes",
          ".gitattributes"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "gitattributes"
    },
    "Git Config": {
      "extension": "git-firefly",
      "path": "languages/gitconfig",
      "matcher": {
        "path_suffixes": [
          "config.worktree",
          ".gitconfig",
          ".gitmodules",
          ".lfsconfig"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "git_config"
    },
    "Git Ignore": {
      "extension": "git-firefly",
      "path": "languages/gitignore",
      "matcher": {
        "path_suffixes": [
          ".containerignore",
          ".cursorignore",
          ".dockerignore",
          ".eslintignore",
          ".fdignore",
          ".gitignore",
          ".git-blame-ignore-revs",
          ".ignore",
          ".npmignore",
          ".prettierignore",
          ".rgignore",
          ".vscodeignore"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "gitignore"
    },
    "Git Rebase": {
      "extension": "git-firefly",
      "path": "languages/gitrebase",
      "matcher": {
        "path_suffixes": [
          "git-rebase-todo"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "git_rebase"
    },
    "Nix": {
      "extension": "nix",
      "path": "languages/nix",
      "matcher": {
        "path_suffixes": [
          "nix"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "nix"
    },
    "QML": {
      "extension": "qml",
      "path": "languages/qml",
      "matcher": {
        "path_suffixes": [
          "qml"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "qmljs"
    },
    "Svelte": {
      "extension": "svelte",
      "path": "languages/svelte",
      "matcher": {
        "path_suffixes": [
          "svelte"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "svelte"
    },
    "TOML": {
      "extension": "toml",
      "path": "languages/toml",
      "matcher": {
        "path_suffixes": [
          "Cargo.lock",
          "toml",
          "Pipfile",
          "uv.lock"
        ],
        "first_line_pattern": null
      },
      "hidden": false,
      "grammar": "toml"
    }
  }
}