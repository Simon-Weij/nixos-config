    "toml": {
      "manifest": {
        "id": "toml",
        "name": "TOML",
        "version": "1.0.3",
        "schema_version": 1,
        "description": "TOML support.",
        "repository": "https://github.com/zed-extensions/toml",
        "authors": [
          "Max Brunsfeld <max@zed.dev>",
          "Ammar Arif <evergreenkary@gmail.com>"
        ],
        "lib": {
          "kind": null,
          "version": null
